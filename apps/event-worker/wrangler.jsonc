{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nxtqr-event-worker",
  "main": "./src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nxtqr-db",
      "database_id": "6d36ec62-7f19-4d14-ac8f-ba2ba4c93c7b",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "nxtqr-scan-telemetry"
      },
      {
        "queue": "nxtqr-report-jobs"
      }
    ]
  }
}
