{
  "name": "nxtqr",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "dev": "next dev",
    "dev:all": "turbo dev",
    "build": "next build",
    "start": "next start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck && tsc --noEmit",
    "test": "tsx scripts/test-qr-studio.ts && tsx scripts/test-organization-rbac.ts && tsx scripts/test-phase12-contracts.ts && tsx scripts/test-phase10-billing.ts && tsx scripts/test-phase9-collaboration.ts && tsx scripts/test-phase8-security.ts && tsx scripts/test-phase7-redirect.ts && tsx scripts/test-phase6-analytics.ts && tsx scripts/test-phase4-data.ts && tsx scripts/test-domains.ts && tsx scripts/test-guardian.ts",
    "web:dev": "next dev",
    "web:build": "next build",
    "redirect:dev": "wrangler dev --config apps/redirect-worker/wrangler.jsonc",
    "redirect:deploy": "wrangler deploy --config apps/redirect-worker/wrangler.jsonc",
    "collab:dev": "wrangler dev --config apps/collab-worker/wrangler.jsonc",
    "collab:deploy": "wrangler deploy --config apps/collab-worker/wrangler.jsonc",
    "event:dev": "wrangler dev --config apps/event-worker/wrangler.jsonc",
    "event:deploy": "wrangler deploy --config apps/event-worker/wrangler.jsonc",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "d1:seed:local": "wrangler d1 execute DB --local --file=packages/db/seeds/0001_seed_initial.sql",
    "d1:query:local": "pnpm exec wrangler d1 execute DB --local --command \"SELECT id, name, slug, status FROM qr_codes\"",
    "d1:query:remote": "pnpm exec wrangler d1 execute DB --remote --command \"SELECT id, name, slug, status FROM qr_codes\"",
    "d1:seed:remote": "pnpm exec wrangler d1 execute DB --remote --file=packages/db/seeds/0001_seed_initial.sql",
    "clean:cache": "powershell -Command \"Remove-Item -Recurse -Force .next/cache -ErrorAction SilentlyContinue; Write-Output 'Build cache cleaned.'\"",
    "d1:clean:local": "node scripts/clean-local-d1.js"
  },
  "dependencies": {
    "@hugeicons/react": "^1.1.10",
    "@iconify-json/hugeicons": "^1.2.35",
    "@iconify-json/simple-icons": "^1.2.96",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.103.0",
    "@types/qrcode-generator": "^1.0.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-google-charts": "^5.2.1",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "turbo": "^2.4.4",
    "typescript": "^5",
    "wrangler": "^4.132.0"
  }
}
